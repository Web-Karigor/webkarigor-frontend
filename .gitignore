# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/
/deploy/

# production
/build

# misc
.DS_Store
*.pem

# archives — never commit
*.zip
*.ZIP
*.rar
*.7z
*.tar
*.tar.gz
*.tgz

# nested git metadata — never commit (root .git is already local-only)
**/.git/
**/.git
!.gitkeep
!**/.gitkeep

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
